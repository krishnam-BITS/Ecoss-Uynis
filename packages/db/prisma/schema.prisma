// Learn more about Prisma schema at https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference

// Define your own database connection string in .env
// Example: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uynis"

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum RepoRole {
  READ
  WRITE
  ADMIN
}

enum RepoVisibility {
  PUBLIC
  PRIVATE
  INTERNAL
}

enum IssueStatus {
  OPEN
  CLOSED
}

enum PullRequestStatus {
  OPEN
  MERGED
  CLOSED
}

enum PullRequestReviewState {
  APPROVED
  CHANGES_REQUESTED
  COMMENTED
}

enum PullRequestCheckStatus {
  QUEUED
  IN_PROGRESS
  SUCCESS
  FAILURE
}

enum NotificationType {
  MENTION
  REVIEW_REQUESTED
  REVIEW_SUBMITTED
  ISSUE_COMMENT
  PULL_COMMENT
  PULL_STATUS
  SYSTEM
  INVITE
}

enum RepoNotificationMode {
  DEFAULT
  WATCH
  MUTE
}

enum RepoImportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum RepoImportType {
  ZIP
  REMOTE
}

enum RepoWebhookEventType {
  PUSH
  ISSUE_CREATED
  PULL_OPENED
  COMMENT_ADDED
}

enum RepoWebhookDeliveryStatus {
  QUEUED
  RUNNING
  DELIVERED
  FAILED
}

enum UploadPurpose {
  REPO_IMPORT_ARCHIVE
  AVATAR
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGIN_BLOCKED
  REQUIRES_VERIFICATION
  REQUIRES_PASSWORD_RESET
  OTP_VERIFIED
  PASSWORD_RESET
  SUSPICIOUS_ACTIVITY
}

enum SecuritySeverity {
  INFO
  WARN
  HIGH
  CRITICAL
}

enum WorkspaceBasePermission {
  NONE
  READ
  WRITE
}

enum WorkspaceAdminRepoAccessMode {
  ALL_REPOS_ADMIN
  BASE_PERMISSION_ONLY
}

enum WorkspaceInvitePolicy {
  OWNERS_AND_ADMINS
  ALL_MEMBERS
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum WorkspaceRepoCreationPolicy {
  OWNERS_AND_ADMINS
  ALL_MEMBERS
}

enum TeamRole {
  MEMBER
  MAINTAINER
}

enum DiscussionThreadCategory {
  RFC
  DESIGN
  DECISION
  QUESTION
}

enum DiscussionThreadStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum DiscussionChannelVisibility {
  PUBLIC
  PRIVATE
}

enum DiscussionCallStatus {
  UPCOMING
  ENDED
}

enum ChatConversationKind {
  DIRECT
  GROUP
}

enum ChatMemberRole {
  MEMBER
  ADMIN
}

enum ChatMessageType {
  TEXT
  TASK
  SYSTEM
}

enum ChatAttachmentKind {
  IMAGE
  VIDEO
  FILE
  AUDIO
}

enum ChatReceiptState {
  SENT
  DELIVERED
  SEEN
  PLAYED
}

enum ChatCallMode {
  AUDIO
  VIDEO
}

enum ChatCallState {
  RINGING
  ACTIVE
  ENDED
  MISSED
}

enum TaskWorkflowStatus {
  ACTIVE
  DRAFT
  PAUSED
}

enum TaskWorkflowTrigger {
  ISSUE_CREATED
  ISSUE_CLOSED
  PULL_CREATED
  PULL_MERGED
}

enum TaskWorkflowRunStatus {
  SUCCESS
  SKIPPED
  FAILED
}

model User {
  id                           String    @id @default(cuid())
  email                        String?   @unique
  phone                        String?
  username                     String?   @unique
  usernameChangedAt            DateTime?
  usernamePrevious             String?
  usernamePreviousChangedAt    DateTime?
  passwordHash                 String
  passwordChangedAt            DateTime?
  passwordResetRequired        Boolean   @default(false)
  name                         String?
  avatarUrl                    String?
  bio                          String?
  location                     String?
  website                      String?
  firstName                    String?
  lastName                     String?
  dateOfBirth                  DateTime?
  gender                       String?
  isVerified                   Boolean   @default(false)
  verificationExpiresAt        DateTime?
  emailVerificationExpiresAt   DateTime?
  phoneVerificationExpiresAt   DateTime?
  emailVerified                Boolean   @default(false)
  phoneVerified                Boolean   @default(false)
  pendingEmail                 String?
  pendingPhone                 String?
  contactVerificationExpiresAt DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  workspaceMemberships        WorkspaceMember[]
  teamMemberships             TeamMember[]
  repoMemberships             RepoMember[]
  issues                      Issue[]
  pullRequests                PullRequest[]
  issueComments               IssueComment[]
  pullComments                PullRequestComment[]
  pullReviews                 PullRequestReview[]
  pullReviewComments          PullRequestReviewComment[]
  sentNotifications           Notification[]               @relation("NotificationActor")
  notifications               Notification[]               @relation("NotificationRecipient")
  notificationPreferences     NotificationPreference?
  repoNotificationPreferences RepoNotificationPreference[]
  starredRepos                RepoStar[]
  pinnedRepos                 RepoPin[]
  issueAssignments            IssueAssignee[]
  pullRequestAssignments      PullRequestAssignee[]
  securityState               UserSecurityState?
  securityEvents              SecurityEvent[]
  sessions                    UserSession[]
  reviewRequestsReceived      PullRequestReviewRequest[]   @relation("PullReviewRequestReviewer")
  reviewRequestsSent          PullRequestReviewRequest[]   @relation("PullReviewRequestAuthor")
  personalWorkspace           Workspace?                   @relation("PersonalWorkspaceOwner")
  workspaceInvitesSent        WorkspaceInvite[]            @relation("WorkspaceInviteInvitedBy")
  workspaceInvitesReceived    WorkspaceInvite[]            @relation("WorkspaceInviteInvitedUser")
  workspaceInvitesAccepted    WorkspaceInvite[]            @relation("WorkspaceInviteAcceptedBy")
  privateAccount              PrivateAccount?
  discussionThreads           DiscussionThread[]
  discussionMessageThreads    DiscussionMessageThread[]
  discussionChannels          DiscussionChannel[]
  discussionCalls             DiscussionCall[]
  discussionMessages          DiscussionMessage[]
  discussionThreadReplies     DiscussionThreadReply[]
  discussionChannelPosts      DiscussionChannelPost[]
  discussionCallNotes         DiscussionCallNote[]
  chatConversationsCreated    ChatConversation[]           @relation("ChatConversationCreator")
  chatConversationMemberships ChatConversationMember[]
  chatMessagesSent            ChatMessage[]                @relation("ChatMessageSender")
  chatMessageReceipts         ChatMessageReceipt[]
  chatCallsStarted            ChatCallSession[]            @relation("ChatCallSessionStarter")
  taskWorkflows               TaskWorkflow[]
  taskWorkflowRuns            TaskWorkflowRun[]            @relation("TaskWorkflowRunActor")
  personalAccessTokens        PersonalAccessToken[]
  uploadTokens                UploadToken[]                @relation("UploadTokenCreator")
  repoImportJobs              RepoImportJob[]              @relation("RepoImportJobCreator")
  usernameReservations        UsernameReservation[]
}

model UsernameReservation {
  id            String   @id @default(cuid())
  username      String   @unique
  userId        String
  createdAt     DateTime @default(now())
  lastClaimedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("UsernameReservation")
}

model Workspace {
  id                           String                       @id @default(cuid())
  name                         String
  slug                         String                       @unique
  isPersonal                   Boolean                      @default(false)
  ownerUserId                  String?                      @unique
  baseRepoPermission           WorkspaceBasePermission      @default(READ)
  publicReadRequiresAuth       Boolean                      @default(false)
  allowOutsideCollaborators    Boolean                      @default(true)
  adminRepoAccessMode          WorkspaceAdminRepoAccessMode @default(BASE_PERMISSION_ONLY)
  description                  String?
  website                      String?
  publicProfileEnabled         Boolean                      @default(false)
  publicProfileShowDetails     Boolean                      @default(true)
  publicProfileShowDescription Boolean                      @default(true)
  publicProfileShowWebsite     Boolean                      @default(true)
  publicProfileShowRepos       Boolean                      @default(true)
  repoCreationPolicy           WorkspaceRepoCreationPolicy  @default(ALL_MEMBERS)
  invitePolicy                 WorkspaceInvitePolicy        @default(OWNERS_AND_ADMINS)
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt

  owner            User?             @relation("PersonalWorkspaceOwner", fields: [ownerUserId], references: [id])
  members          WorkspaceMember[]
  invites          WorkspaceInvite[]
  teams            Team[]
  repos            Repo[]
  taskWorkflows    TaskWorkflow[]
  taskWorkflowRuns TaskWorkflowRun[]

  @@map("Workspace")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspaceId")
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@map("WorkspaceMember")
}

model WorkspaceInvite {
  id              String                @id @default(cuid())
  workspaceId     String
  invitedById     String
  invitedUserId   String?
  invitedEmail    String?
  invitedUsername String?
  role            WorkspaceRole         @default(MEMBER)
  status          WorkspaceInviteStatus @default(PENDING)
  tokenHash       String                @unique
  tokenPrefix     String
  message         String?
  expiresAt       DateTime
  respondedAt     DateTime?
  acceptedById    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("WorkspaceInviteInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser User?     @relation("WorkspaceInviteInvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)
  acceptedBy  User?     @relation("WorkspaceInviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
  @@index([invitedEmail, status, createdAt])
  @@index([invitedUsername, status, createdAt])
  @@index([invitedUserId, status, createdAt])
}

model Team {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspaceId")
  name        String
  slug        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace       Workspace            @relation(fields: [workspaceId], references: [id])
  members         TeamMember[]
  repoPermissions TeamRepoPermission[]

  @@unique([workspaceId, slug])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
}

model Repo {
  id                     String         @id @default(cuid())
  workspaceId            String         @map("workspaceId")
  name                   String
  slug                   String
  description            String?
  visibility             RepoVisibility @default(PRIVATE)
  publicReadRequiresAuth Boolean        @default(false)
  defaultBranch          String         @default("main")
  forkedFromRepoId       String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  workspace               Workspace                    @relation(fields: [workspaceId], references: [id])
  forkedFrom              Repo?                        @relation("RepoForks", fields: [forkedFromRepoId], references: [id], onDelete: SetNull)
  forks                   Repo[]                       @relation("RepoForks")
  rules                   BranchRule[]
  members                 RepoMember[]
  teamPermissions         TeamRepoPermission[]
  issues                  Issue[]
  pullRequests            PullRequest[]
  notificationPreferences RepoNotificationPreference[]
  stars                   RepoStar[]
  pins                    RepoPin[]
  labels                  RepoLabel[]
  automationTokens        RepoAutomationToken[]
  importJobs              RepoImportJob[]
  uploadTokens            UploadToken[]
  webhookSecret           RepoWebhookSecret?
  webhooks                RepoWebhook[]
  commitChecks            CommitCheck[]
  taskWorkflows           TaskWorkflow[]
  taskWorkflowRuns        TaskWorkflowRun[]

  @@unique([workspaceId, slug])
  @@index([forkedFromRepoId])
}

model UploadToken {
  id          String        @id @default(cuid())
  purpose     UploadPurpose
  tokenHash   String        @unique
  tokenPrefix String
  repoId      String?
  createdById String?
  maxBytes    Int
  contentType String?
  fileName    String?
  storagePath String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  repo      Repo? @relation(fields: [repoId], references: [id], onDelete: Cascade)
  createdBy User? @relation("UploadTokenCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([purpose, expiresAt])
  @@index([repoId, createdAt])
}

model RepoImportJob {
  id               String           @id @default(cuid())
  repoId           String
  createdById      String?
  type             RepoImportType
  status           RepoImportStatus @default(QUEUED)
  branch           String?
  message          String?
  importUrl        String?
  archivePath      String?
  attempts         Int              @default(0)
  maxAttempts      Int              @default(3)
  nextRunAt        DateTime?
  importedFiles    Int?
  importedBranches Int?
  defaultBranch    String?
  commitSha        String?
  error            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  repo      Repo  @relation(fields: [repoId], references: [id], onDelete: Cascade)
  createdBy User? @relation("RepoImportJobCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([repoId, createdAt])
  @@index([status, createdAt])
}

model RepoAutomationToken {
  id          String    @id @default(cuid())
  repoId      String
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  scopes      String[]  @default([])
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, createdAt])
  @@index([revokedAt])
}

model RepoWebhookSecret {
  id         String   @id @default(cuid())
  repoId     String   @unique
  secretHash String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)
}

model RepoWebhook {
  id            String                  @id @default(cuid())
  repoId        String
  name          String
  url           String
  active        Boolean                 @default(true)
  events        RepoWebhookEventType[]  @default([])
  maxAttempts   Int                     @default(5)
  timeoutMs     Int                     @default(10000)
  lastDeliveryAt DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  repo       Repo                  @relation(fields: [repoId], references: [id], onDelete: Cascade)
  deliveries RepoWebhookDelivery[]

  @@index([repoId, active])
  @@unique([repoId, url])
}

model RepoWebhookDelivery {
  id             String                    @id @default(cuid())
  webhookId      String
  eventType      RepoWebhookEventType
  status         RepoWebhookDeliveryStatus @default(QUEUED)
  payload        Json
  attemptCount   Int                       @default(0)
  maxAttempts    Int                       @default(5)
  nextAttemptAt  DateTime?
  responseStatus Int?
  responseBody   String?
  error          String?
  deliveredAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  webhook RepoWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt])
  @@index([webhookId, createdAt])
}

model RepoMember {
  id        String   @id @default(cuid())
  repoId    String
  userId    String
  role      RepoRole @default(READ)
  createdAt DateTime @default(now())

  repo Repo @relation(fields: [repoId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([repoId, userId])
}

model BranchRule {
  id                String   @id @default(cuid())
  repoId            String
  pattern           String   @default("main")
  requirePr         Boolean  @default(true)
  requireCodeOwners Boolean  @default(false)
  requireApprovals  Int      @default(1)
  blockDirectPush   Boolean  @default(true)
  requiredChecks    String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  repo Repo @relation(fields: [repoId], references: [id])

  @@unique([repoId, pattern])
}

model TeamRepoPermission {
  id        String   @id @default(cuid())
  teamId    String
  repoId    String
  role      RepoRole @default(READ)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  repo Repo @relation(fields: [repoId], references: [id])

  @@unique([teamId, repoId])
}

model Issue {
  id        String      @id @default(cuid())
  repoId    String
  authorId  String
  title     String
  body      String?
  status    IssueStatus @default(OPEN)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  repo      Repo            @relation(fields: [repoId], references: [id])
  author    User            @relation(fields: [authorId], references: [id])
  comments  IssueComment[]
  assignees IssueAssignee[]
  labels    IssueLabel[]

  @@index([repoId, status, createdAt])
}

model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  issue  Issue @relation(fields: [issueId], references: [id])
  author User  @relation(fields: [authorId], references: [id])
}

model PullRequest {
  id           String            @id @default(cuid())
  repoId       String
  authorId     String
  title        String
  body         String?
  status       PullRequestStatus @default(OPEN)
  sourceBranch String
  targetBranch String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  repo           Repo                       @relation(fields: [repoId], references: [id])
  author         User                       @relation(fields: [authorId], references: [id])
  comments       PullRequestComment[]
  reviews        PullRequestReview[]
  checks         PullRequestCheck[]
  reviewComments PullRequestReviewComment[]
  reviewRequests PullRequestReviewRequest[]
  assignees      PullRequestAssignee[]
  labels         PullRequestLabel[]

  @@index([repoId, status, createdAt])
}

model RepoLabel {
  id          String   @id @default(cuid())
  repoId      String
  name        String
  nameKey     String
  color       String   @default("#5B8CFF")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  repo       Repo               @relation(fields: [repoId], references: [id], onDelete: Cascade)
  issueLinks IssueLabel[]
  pullLinks  PullRequestLabel[]

  @@unique([repoId, nameKey])
  @@index([repoId, name])
}

model IssueAssignee {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@index([userId, createdAt])
}

model IssueLabel {
  id        String   @id @default(cuid())
  issueId   String
  labelId   String
  createdAt DateTime @default(now())

  issue Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label RepoLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
  @@index([labelId, createdAt])
}

model PullRequestAssignee {
  id            String   @id @default(cuid())
  pullRequestId String
  userId        String
  createdAt     DateTime @default(now())

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, userId])
  @@index([userId, createdAt])
}

model PullRequestLabel {
  id            String   @id @default(cuid())
  pullRequestId String
  labelId       String
  createdAt     DateTime @default(now())

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  label       RepoLabel   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, labelId])
  @@index([labelId, createdAt])
}

model PullRequestComment {
  id            String   @id @default(cuid())
  pullRequestId String
  authorId      String
  body          String
  createdAt     DateTime @default(now())

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id])
  author      User        @relation(fields: [authorId], references: [id])
}

model PullRequestReview {
  id            String                 @id @default(cuid())
  pullRequestId String
  reviewerId    String
  state         PullRequestReviewState @default(COMMENTED)
  body          String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  reviewer    User        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, reviewerId])
}

model PullRequestCheck {
  id            String                 @id @default(cuid())
  pullRequestId String
  context       String
  status        PullRequestCheckStatus @default(QUEUED)
  details       String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, context])
}

model CommitCheck {
  id        String                 @id @default(cuid())
  repoId    String
  commitSha String
  context   String
  status    PullRequestCheckStatus @default(QUEUED)
  details   String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, commitSha, context])
  @@index([repoId, commitSha])
  @@index([repoId, context])
}

model PullRequestReviewComment {
  id            String   @id @default(cuid())
  pullRequestId String
  authorId      String
  path          String
  line          Int?
  body          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([pullRequestId, path])
}

model PullRequestReviewRequest {
  id            String    @id @default(cuid())
  pullRequestId String
  reviewerId    String
  requestedById String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  fulfilledAt   DateTime?

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  reviewer    User        @relation("PullReviewRequestReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  requestedBy User        @relation("PullReviewRequestAuthor", fields: [requestedById], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, reviewerId])
  @@index([reviewerId, fulfilledAt])
}

model DiscussionThread {
  id            String                   @id @default(cuid())
  title         String
  category      DiscussionThreadCategory @default(RFC)
  status        DiscussionThreadStatus   @default(OPEN)
  replies       Int                      @default(0)
  workspaceName String
  repoName      String
  createdById   String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  createdBy    User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  replyEntries DiscussionThreadReply[]

  @@index([status, updatedAt])
  @@index([category, updatedAt])
  @@index([workspaceName, repoName])
}

model DiscussionMessageThread {
  id          String   @id @default(cuid())
  name        String
  preview     String
  members     Int      @default(2)
  unread      Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  messages  DiscussionMessage[]

  @@index([updatedAt])
}

model DiscussionChannel {
  id          String                      @id @default(cuid())
  name        String
  topic       String
  visibility  DiscussionChannelVisibility @default(PUBLIC)
  members     Int                         @default(1)
  createdById String?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  createdBy User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  posts     DiscussionChannelPost[]

  @@index([visibility, updatedAt])
}

model DiscussionCall {
  id          String               @id @default(cuid())
  title       String
  host        String
  startsAt    DateTime
  status      DiscussionCallStatus @default(UPCOMING)
  attendees   Int                  @default(1)
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  createdBy User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  notes     DiscussionCallNote[]

  @@index([status, startsAt])
}

model DiscussionCallNote {
  id        String   @id @default(cuid())
  callId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  call   DiscussionCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  author User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([callId, createdAt])
}

model DiscussionMessage {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  thread DiscussionMessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User?                   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
}

model DiscussionThreadReply {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
}

model DiscussionChannelPost {
  id        String   @id @default(cuid())
  channelId String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  channel DiscussionChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt])
}

model ChatConversation {
  id                 String               @id @default(cuid())
  kind               ChatConversationKind
  name               String?
  description        String?
  directKey          String?              @unique
  lastMessageAt      DateTime?
  lastMessagePreview String?
  createdById        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  createdBy User?                     @relation("ChatConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   ChatConversationMember[]
  messages  ChatMessage[]
  calls     ChatCallSession[]

  @@index([kind, updatedAt])
  @@index([lastMessageAt])
}

model ChatConversationMember {
  id                String         @id @default(cuid())
  conversationId    String
  userId            String
  role              ChatMemberRole @default(MEMBER)
  joinedAt          DateTime       @default(now())
  lastReadMessageId String?
  lastReadAt        DateTime?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, joinedAt])
  @@index([conversationId, role])
}

model ChatMessage {
  id             String          @id @default(cuid())
  conversationId String
  senderId       String
  type           ChatMessageType @default(TEXT)
  body           String
  metadata       Json?
  createdAt      DateTime        @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  conversation ChatConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User               @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments  ChatAttachment[]
  receipts     ChatMessageReceipt[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model ChatAttachment {
  id        String             @id @default(cuid())
  messageId String
  kind      ChatAttachmentKind
  url       String
  fileName  String?
  mimeType  String?
  sizeBytes BigInt?
  expiresAt DateTime?
  createdAt DateTime           @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

model ChatMessageReceipt {
  id          String           @id @default(cuid())
  messageId   String
  userId      String
  state       ChatReceiptState @default(SENT)
  deliveredAt DateTime?
  seenAt      DateTime?
  playedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, state, updatedAt])
}

model ChatCallSession {
  id             String        @id @default(cuid())
  conversationId String
  startedById    String
  mode           ChatCallMode
  state          ChatCallState @default(RINGING)
  startedAt      DateTime      @default(now())
  endedAt        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  startedBy    User             @relation("ChatCallSessionStarter", fields: [startedById], references: [id], onDelete: Cascade)

  @@index([conversationId, startedAt])
  @@index([startedById, startedAt])
}

model TaskWorkflow {
  id          String              @id @default(cuid())
  userId      String
  workspaceId String?
  repoId      String?
  title       String
  description String
  status      TaskWorkflowStatus  @default(DRAFT)
  trigger     TaskWorkflowTrigger @default(PULL_MERGED)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  repo      Repo?             @relation(fields: [repoId], references: [id], onDelete: SetNull)
  runs      TaskWorkflowRun[]

  @@index([userId, updatedAt])
  @@index([workspaceId, status])
  @@index([repoId, status])
}

model TaskWorkflowRun {
  id            String                @id @default(cuid())
  workflowId    String
  actorId       String?
  workspaceId   String?
  repoId        String?
  issueId       String?
  pullRequestId String?
  trigger       TaskWorkflowTrigger
  status        TaskWorkflowRunStatus @default(SUCCESS)
  message       String?
  createdAt     DateTime              @default(now())

  workflow  TaskWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  actor     User?        @relation("TaskWorkflowRunActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspace Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  repo      Repo?        @relation(fields: [repoId], references: [id], onDelete: SetNull)

  @@index([workflowId, createdAt])
  @@index([actorId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([repoId, createdAt])
}

model Notification {
  id            String           @id @default(cuid())
  recipientId   String
  actorId       String?
  type          NotificationType
  title         String
  body          String?
  workspaceId   String?
  repoId        String?
  issueId       String?
  pullRequestId String?
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([recipientId, type, createdAt])
}

model NotificationPreference {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  inAppActivityEnabled   Boolean  @default(true)
  mentionsEnabled        Boolean  @default(true)
  reviewRequestsEnabled  Boolean  @default(true)
  reviewSubmittedEnabled Boolean  @default(true)
  issueCommentsEnabled   Boolean  @default(true)
  pullCommentsEnabled    Boolean  @default(true)
  pullStatusEnabled      Boolean  @default(true)
  systemEnabled          Boolean  @default(true)
  emailMentionsEnabled   Boolean  @default(false)
  emailReviewsEnabled    Boolean  @default(false)
  productUpdatesEnabled  Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RepoNotificationPreference {
  id        String               @id @default(cuid())
  userId    String
  repoId    String
  mode      RepoNotificationMode @default(DEFAULT)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([userId, repoId])
  @@index([repoId, mode])
}

model RepoStar {
  id        String   @id @default(cuid())
  userId    String
  repoId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([userId, repoId])
  @@index([repoId, createdAt])
}

model RepoPin {
  id        String   @id @default(cuid())
  userId    String
  repoId    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([userId, repoId])
  @@index([userId, sortOrder])
}

model UserSecurityState {
  id                 String    @id @default(cuid())
  userId             String    @unique
  failedLoginCount   Int       @default(0)
  lastFailedLoginAt  DateTime?
  lastLoginAt        DateTime?
  lockedUntil        DateTime?
  riskScore          Int       @default(0)
  forceReverify      Boolean   @default(false)
  forcePasswordReset Boolean   @default(false)
  lastLoginIp        String?
  lastLoginUserAgent String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lockedUntil])
  @@index([riskScore])
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  tokenId    String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model SecurityEvent {
  id         String            @id @default(cuid())
  userId     String?
  eventType  SecurityEventType
  severity   SecuritySeverity  @default(INFO)
  identifier String?
  ipAddress  String?
  userAgent  String?
  reason     String?
  metadata   Json?
  createdAt  DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([eventType, severity, createdAt])
}

enum PrivateAccountStatus {
  ACTIVE
  ARCHIVED
  MIGRATED_TO_PERSONAL
  DELETED
}

model PrivateAccount {
  id                 String  @id @default(cuid())
  userId             String  @unique
  username           String  @unique
  passwordHash       String
  recoveryPhrase     String?
  recoveryPhraseHash String

  // Recovery verification: tracks which recovery methods are enabled
  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  recoveryEmail   String?
  recoveryPhone   String?

  // Lifecycle timestamps
  createdAt   DateTime @default(now())
  lastLoginAt DateTime @default(now())
  expiresAt   DateTime // Calculated as: createdAt + 90 days (auto-updated on login)

  // Account state management
  status           PrivateAccountStatus @default(ACTIVE)
  migratedToUserId String?
  archivedAt       DateTime?
  deletedAt        DateTime?

  // Data export/archive
  dataExportedAt DateTime?
  archivedData   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([expiresAt])
  @@index([status])
}

model PersonalAccessToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  scopes      String[]  @default([])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([revokedAt])
  @@index([expiresAt])
}
