# Uynis environment template
# Copy to .env and update values for your environment.

# Database and cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/uynis
# Docker-internal DB URL used by compose services (do not set to localhost)
DATABASE_URL_DOCKER=postgresql://postgres:postgres@postgres:5432/uynis
REDIS_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=UynisSearch1!

# Service ports
API_PORT=4000
GIT_PORT=4001

# Security secrets (change in production)
JWT_SECRET=dev-secret-change-me
UPLOAD_TOKEN_SECRET=dev-upload-secret-change-me
OTP_HMAC_SECRET=dev-otp-secret-change-me
OTP_TTL_MS=600000
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_WINDOW=4
OTP_SEND_LOCK_WINDOW_MS=3600000
OTP_SENDER_EMAIL=no-reply@uynis.local
OTP_SENDER_PHONE=Uynis
MESSAGE_DELIVERY_PROVIDER=webhook
# Point this at the temporary emulator while no real provider is connected.
MESSAGE_DELIVERY_WEBHOOK_URL=http://localhost:3011/api/messages
MESSAGE_DELIVERY_WEBHOOK_BEARER=
MESSAGE_DELIVERY_SHARED_KEY=dev-delivery-shared-key
# Optional direct provider settings:
# MESSAGE_DELIVERY_PROVIDER=sendgrid -> email only
MESSAGE_DELIVERY_SENDGRID_API_KEY=
MESSAGE_DELIVERY_SENDGRID_FROM_EMAIL=
# MESSAGE_DELIVERY_PROVIDER=twilio -> phone only
MESSAGE_DELIVERY_TWILIO_ACCOUNT_SID=
MESSAGE_DELIVERY_TWILIO_AUTH_TOKEN=
MESSAGE_DELIVERY_TWILIO_FROM_PHONE=
# MESSAGE_DELIVERY_PROVIDER=auto -> email via SendGrid, phone via Twilio, fallback to webhook
# Optional values for the standalone delivery emulator under temp/:
# DELIVERY_EMULATOR_PORT=3011
# DELIVERY_EMULATOR_SHARED_KEY=dev-delivery-shared-key
# DELIVERY_EMULATOR_STORE_KEY=delivery-emulator-dev-key

# Repository storage
REPO_STORAGE_PATH=data/repos
REQUIRE_REPO_STORAGE_PATH=false

# S3-compatible object storage (MinIO by default)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=uynisminio
S3_SECRET_KEY=uynisminiosecret
S3_REGION=us-east-1
S3_BUCKET_UPLOADS=uynis-uploads

# Import job processing
IMPORT_WORKER_ENABLED=true
IMPORT_JOB_POLL_MS=3000
IMPORT_JOB_STALE_MS=1800000
IMPORT_JOB_RETRY_BASE_MS=30000
IMPORT_UPLOAD_MAX_BYTES=262144000

# Upload limits
UPLOAD_BODY_LIMIT=262144000
ATTACHMENT_MAX_BYTES=10485760

# Public URLs
API_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GIT_URL=http://localhost:4001
UYNIS_API_URL=http://localhost:4000
UYNIS_SDK_BASE_URL=http://localhost:4000

# Platform admins (comma-separated)
ADMIN_EMAILS=km@edilec.com
ADMIN_USER_IDS=
ALLOW_DEV_ADMIN_FALLBACK=false
