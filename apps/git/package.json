    "ioredis": "^5.8.1"
  },
  "devDependencies": {
    "@types/node": "20.14.15",
    "eslint": "8.57.0",
    "tsx": "4.17.0",
    "tsup": "8.2.4",
    "typescript": "5.5.4"
  }
}
